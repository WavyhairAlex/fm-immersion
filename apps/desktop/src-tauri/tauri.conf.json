{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FM Immersion",
  "version": "../package.json",
  "identifier": "app.fmimmersion.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FM Immersion",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self'; style-src-attr 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "FM Immersion",
    "copyright": "FM Immersion — licence MIT",
    "category": "Utility",
    "shortDescription": "Le compagnon de tes parties de Football Manager",
    "longDescription": "FM Immersion : visages photoréalistes, assistant FM Coach et outils d'immersion pour Football Manager. Projet indépendant, sans lien avec Sports Interactive ni SEGA. Toutes les données restent sur ton PC.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French", "English"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ2ODI3OUI2NDA5MUYyQUMKUldTczhwRkF0bm1DMXR2R3lubE5USFJaK2loQjh1S3hlTVp4UGZmVGdWNzN3TEU2UmxFRXhBaE0K",
      "endpoints": ["https://github.com/amnesix-nt/fm-immersion/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Simloom",
  "version": "../package.json",
  "identifier": "app.simloom.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Simloom",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self'; style-src-attr 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Simloom",
    "copyright": "Simloom — licence MIT",
    "category": "Utility",
    "shortDescription": "Le compagnon de tes parties de jeux de gestion",
    "longDescription": "Simloom regroupe le suivi de tes parties de jeux de gestion dans un seul tableau de bord. Toutes les données restent sur ton PC.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French", "English"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlEMkQ4N0Q1MjVERkNBQ0QKUldUTnl0OGwxWWN0blVDWkUxbmh2VTArS1NZaGxwbUhrTTJIOTlXazJnTW9halFNazBFQU5aeDYK",
      "endpoints": ["https://github.com/amnesix-nt/simloom/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}

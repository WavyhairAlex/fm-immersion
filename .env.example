# Copier en .env à la racine (lu par l'API et par Drizzle).

# Base de données
DATABASE_URL=postgres://simloom:simloom@localhost:5432/simloom

# API
PORT=3001
NODE_ENV=development
# URL publique du front, utilisée pour CORS et la vérification d'origine
WEB_ORIGIN=http://localhost:5173
# Secret de 32 caractères minimum pour hacher les codes de connexion
# (générer avec : openssl rand -base64 48)
AUTH_SECRET=change-me-change-me-change-me-change-me

# Emails
# Local : Mailpit (docker compose). Production : Scaleway TEM (smtp.tem.scaleway.com, port 587 ou 465).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Simloom <noreply@simloom.app>"

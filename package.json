{
  "name": "fm-immersion",
  "private": true,
  "description": "FM Immersion — le compagnon de bureau de tes jeux de gestion. Every game, one thread.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @fm-immersion/db generate",
    "app": "pnpm --filter @fm-immersion/desktop dev",
    "app:bundle": "pnpm --filter @fm-immersion/desktop bundle"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "license": "MIT"
}
